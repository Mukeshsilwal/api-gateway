# AWS Production Environment Variables
# Copy this file to .env to use the AWS backend

# 1. Get your LoadBalancer URL by running:
# kubectl get ingress -n ticket-katum -o jsonpath='{.status.loadBalancer.ingress[0].hostname}'
# OR check the 'Active Endpoint' in the walkthrough.

# Run this to get your URL: kubectl get svc web-bff -n ticket-katum -o jsonpath='{.status.loadBalancer.ingress[0].hostname}'
VITE_API_URL=http://a3a3f175981ed4a93934f196a581a3e5-2125346135.us-east-1.elb.amazonaws.com
VITE_FRONTEND_URL=http://localhost:3000

# Payment Gateway Keys (Production)
VITE_KHALTI_PUBLIC_KEY=your_production_khalti_key
VITE_ESEWA_MERCHANT_ID=your_production_esewa_merchant_id

# Environment
NODE_ENV=production
