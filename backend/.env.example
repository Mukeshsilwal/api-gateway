# ============================================================
# TICKET KATUM - ENVIRONMENT VARIABLES TEMPLATE
# ============================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
# ============================================================

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
# Main PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=ticketkatum
DB_PASSWORD=your_secure_password_here

# Kong Database
KONG_DB_PASSWORD=your_kong_password_here

# ============================================================
# REDIS CONFIGURATION
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# ============================================================
# RABBITMQ CONFIGURATION
# ============================================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=ticketkatum
RABBITMQ_PASSWORD=your_rabbitmq_password_here

# ============================================================
# SECURITY
# ============================================================
# Generate a secure random string (minimum 64 characters)
# You can use: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_minimum_64_characters_long_random_string_here

# ============================================================
# PAYMENT GATEWAYS
# ============================================================
# Stripe
STRIPE_API_KEY=your_stripe_api_key_here

# eSewa
ESEWA_MERCHANT_ID=your_esewa_merchant_id_here
ESEWA_SECRET_KEY=your_esewa_secret_key_here

# Khalti
KHALTI_SECRET_KEY=your_khalti_secret_key_here
KHALTI_PUBLIC_KEY=your_khalti_public_key_here

# FonePay
FONEPAY_MERCHANT_ID=your_fonepay_merchant_id_here
FONEPAY_SECRET_KEY=your_fonepay_secret_key_here

# ============================================================
# EMAIL CONFIGURATION
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password_here

# SendGrid (alternative)
SENDGRID_API_KEY=your_sendgrid_api_key_here

# ============================================================
# SMS CONFIGURATION
# ============================================================
SMS_PROVIDER=sparrow
SMS_API_KEY=your_sms_api_key_here

# ============================================================
# CORS CONFIGURATION
# ============================================================
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,https://ticketkatum.com

# ============================================================
# SERVICE PORTS (Optional - defaults are fine for development)
# ============================================================
WEB_BFF_PORT=8081
MOBILE_BFF_PORT=8082
AUTH_SERVICE_PORT=8089
BOOKING_SERVICE_PORT=8091
BUS_SERVICE_PORT=8083
HOTEL_SERVICE_PORT=8087
PAYMENT_SERVICE_PORT=8092

# ============================================================
# MONITORING & OBSERVABILITY
# ============================================================
JAEGER_ENDPOINT=http://jaeger:4318/v1/traces
TRACING_SAMPLE_RATE=0.1
PROMETHEUS_ENABLED=true

# ============================================================
# FEATURE FLAGS
# ============================================================
CACHE_ENABLED=true
RATE_LIMIT_ENABLED=true
EMAIL_ENABLED=true
SMS_ENABLED=false

# ============================================================
# ENVIRONMENT
# ============================================================
SPRING_PROFILES_ACTIVE=dev
# Options: dev, staging, prod
